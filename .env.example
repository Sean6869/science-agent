# Server
PORT=4173

# Public, non-secret iframe target. The app defaults to this value if unset.
PUBLIC_NOBOOK_LENS_RESOURCE_URL=https://wl.nobook.com/console/templates/resource/207_d2c4a829c23aa7471a0344a92e34cb74

# Optional DeepSeek Agent integration. Leave the key empty to use local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Short classroom feedback uses non-thinking mode by default.
DEEPSEEK_THINKING=disabled
# Only used when thinking is enabled: low / high / max
DEEPSEEK_REASONING_EFFORT=low
