# Server
PORT=4173

# Public, non-secret PhET iframe target. The app defaults to this Chinese lens screen if unset.
PUBLIC_PHET_GEOMETRIC_OPTICS_URL=https://phet.colorado.edu/sims/html/geometric-optics/latest/geometric-optics_zh_CN.html?screens=1

# Optional DeepSeek Agent integration. Leave the key empty to use local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Short classroom feedback uses non-thinking mode by default.
DEEPSEEK_THINKING=disabled
# Only used when thinking is enabled: low / high / max
DEEPSEEK_REASONING_EFFORT=low
