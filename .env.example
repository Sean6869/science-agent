# Server
PORT=4173

# Initial teacher account. Required only when creating a new database.
TEACHER_USERNAME=teacher
# Set a unique password with at least 12 characters; there is no default password.
TEACHER_PASSWORD=
# Local storage. Railway automatically uses the attached volume mount path instead.
DATA_DIR=./data

# Public, non-secret PhET iframe target. The app defaults to this Chinese lens screen if unset.

# Optional DeepSeek Agent integration. Leave the key empty to use local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Short classroom feedback uses non-thinking mode by default.
DEEPSEEK_THINKING=disabled
# Only used when thinking is enabled: low / high / max
DEEPSEEK_REASONING_EFFORT=low
