# Server
PORT=4173

# Initial administrator. Required only when creating a new database.
ADMIN_USERNAME=admin
# Set a unique password with at least 12 characters; there is no default password.
ADMIN_PASSWORD=
# Local storage. Railway automatically uses the attached volume mount path instead.
DATA_DIR=./data

# Online scientific-reasoning posttest is hidden by default because it is
# administered on paper. Set to true only when the online workflow is restored.
ONLINE_REASONING_POSTTEST_ENABLED=false

# Optional DeepSeek Agent integration. Leave the key empty to use local fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Short classroom feedback uses non-thinking mode by default.
DEEPSEEK_THINKING=disabled
# Only used when thinking is enabled: low / high / max
DEEPSEEK_REASONING_EFFORT=low

# Tencent Cloud premium TTS; generated audio persists on the Railway Volume.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
